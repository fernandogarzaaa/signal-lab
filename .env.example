# Environment variables read by signal-lab. All optional; no secrets required.

# Set to 1 to enable the FinBERT embedding path (offline-safe; off by default).
SIGNAL_LAB_FINBERT=
# Override the FinBERT embedding cache dir (default ~/.cache/signal_lab/finbert).
SIGNAL_LAB_FINBERT_CACHE=
# Hugging Face cache locations (standard HF variables).
HF_HOME=
HUGGINGFACE_HUB_CACHE=
# CLI server (packages/cli/server.js): monitor interval in minutes (default 15).
SIGNAL_LAB_MONITOR_MINUTES=
